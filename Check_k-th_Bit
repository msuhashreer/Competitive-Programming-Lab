import java.util.*;
public class Main {
    static int checkBit(int n, int k) {
        return (n >> k) & 1;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int k = sc.nextInt();
        System.out.println(checkBit(n, k));
        sc.close();
    }
}
