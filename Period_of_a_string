import java.util.*;

public class Main {

    static int findPeriod(String s) {
        int n = s.length();
        for (int p = 1; p <= n; p++) {
            if (n % p != 0)
                continue;
            boolean same = true;
            for (int i = 0; i < n; i++) {
                if (s.charAt(i) != s.charAt(i % p)) {
                    same = false;
                    break;
                }
            }
            if (same)
                return p;
        }
        return n;
    }
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        String s = sc.nextLine();
        System.out.println(findPeriod(s));
    }
}
